# gzh-matrix 运行配置示例：复制为 .env 后按需修改（.env 已被 gitignore，不会入库）

# 管理员登录密码（用户名 admin），必填，不设则无法登录
ADMIN_PASSWORD=change-me-to-a-strong-password

# 本服务器出口 IP（可选）：配置后账号管理页会出现「复制服务器 IP」按钮，方便加公众号后台白名单
# NEXT_PUBLIC_SERVER_IP=

# 会话签名密钥，建议设置；可用 `openssl rand -hex 24` 生成
AUTH_SECRET=

# 以下均可选，注释掉即用默认值
# 队列任务间隔（毫秒），默认 120000
# QUEUE_GAP_MS=120000
# gzh-design 排版技能目录，默认依次找 ../.agents/skills/gzh-design → ./skills/gzh-design
# GZH_SKILL_DIR=
# 文章发布目标 git 裸仓库（用于发布统计，可按需指向自己的仓库）
# GIT_REPO_DIR=
# git 提交统计路径，默认 "ui-v3 official-site"
# GIT_LOG_PATHS=ui-v3 official-site
# 生成文章输出目录，默认 ./data/articles
# ARTICLE_OUT_DIR=
# Redfox（红狐数据）API Key：微信公众号爆文搜索（redfox.hk），可选；不配则选题降级为纯联网检索
# REDFOX_API_KEY=
